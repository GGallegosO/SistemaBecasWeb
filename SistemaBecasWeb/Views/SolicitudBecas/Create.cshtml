@model SistemaBecasWeb.Models.SolicitudBeca

@{
    ViewData["Title"] = "Nueva Postulación";
}

<div class="container mt-4">
    <h2>Formulario de Registro de Beca</h2>
    <h4>Ingrese los datos del estudiante para postular</h4>
    <hr />

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="NombreEstudiante" class="control-label fw-bold">Nombre Completo</label>
                    <input asp-for="NombreEstudiante" class="form-control" placeholder="Ej: Juan Pérez" />
                    <span asp-validation-for="NombreEstudiante" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Rut" class="control-label fw-bold">RUT (con guión y dígito verificador)</label>
                    <input asp-for="Rut" class="form-control" placeholder="Ej: 12345678-9" />
                    <span asp-validation-for="Rut" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Carrera" class="control-label fw-bold">Carrera</label>
                    <input asp-for="Carrera" class="form-control" placeholder="Ej: Analista Programador" />
                    <span asp-validation-for="Carrera" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PromedioNotas" class="control-label fw-bold">Promedio de Notas</label>
                    <input asp-for="PromedioNotas" class="form-control" type="number" step="0.1" placeholder="Ej: 5.8" />
                    <span asp-validation-for="PromedioNotas" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IngresoFamiliar" class="control-label fw-bold">Ingreso Familiar Mensual ($)</label>
                    <input asp-for="IngresoFamiliar" class="form-control" type="number" placeholder="Ej: 600000" />
                    <span asp-validation-for="IngresoFamiliar" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IntegrantesFamilia" class="control-label fw-bold">Cantidad de Integrantes del Grupo Familiar</label>
                    <input asp-for="IntegrantesFamilia" class="form-control" type="number" placeholder="Ej: 4" />
                    <span asp-validation-for="IntegrantesFamilia" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="SituacionLaboral" class="control-label fw-bold">Situación Laboral</label>
                    <select asp-for="SituacionLaboral" class="form-select">
                        <option value="">-- Seleccione una opción --</option>
                        <option value="Trabaja">Trabaja</option>
                        <option value="No trabaja">No trabaja</option>
                    </select>
                    <span asp-validation-for="SituacionLaboral" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle"></i> Registrar Solicitud
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Volver al Listado</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}