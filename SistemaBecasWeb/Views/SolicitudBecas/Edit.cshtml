@model SistemaBecasWeb.Models.SolicitudBeca

@{
    ViewData["Title"] = "Editar Postulación";
}

<div class="container mt-4">
    <h2>Formulario de Edición</h2>
    <h4>Modificar datos o cambiar estado de la solicitud</h4>
    <hr />

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="IdSolicitud" />

                <input type="hidden" asp-for="Puntaje" />
                <input type="hidden" asp-for="Resultado" />
                <input type="hidden" asp-for="FechaSolicitud" />

                <div class="form-group mb-3">
                    <label asp-for="NombreEstudiante" class="control-label fw-bold">Nombre Completo</label>
                    <input asp-for="NombreEstudiante" class="form-control" />
                    <span asp-validation-for="NombreEstudiante" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Rut" class="control-label fw-bold">RUT</label>
                    <input asp-for="Rut" class="form-control" />
                    <span asp-validation-for="Rut" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Carrera" class="control-label fw-bold">Carrera</label>
                    <input asp-for="Carrera" class="form-control" />
                    <span asp-validation-for="Carrera" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PromedioNotas" class="control-label fw-bold">Promedio de Notas</label>
                    <input asp-for="PromedioNotas" class="form-control" type="number" step="any" lang="en-US" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IngresoFamiliar" class="control-label fw-bold">Ingreso Familiar Mensual ($)</label>
                    <input asp-for="IngresoFamiliar" class="form-control" type="number" />
                    <span asp-validation-for="IngresoFamiliar" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IntegrantesFamilia" class="control-label fw-bold">Cantidad de Integrantes</label>
                    <input asp-for="IntegrantesFamilia" class="form-control" type="number" />
                    <span asp-validation-for="IntegrantesFamilia" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SituacionLaboral" class="control-label fw-bold">Situación Laboral</label>
                    <select asp-for="SituacionLaboral" class="form-select">
                        <option value="Trabaja">Trabaja</option>
                        <option value="No trabaja">No trabaja</option>
                    </select>
                    <span asp-validation-for="SituacionLaboral" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="EstadoSolicitud" class="control-label fw-bold text-primary">Estado de la Solicitud</label>
                    <select asp-for="EstadoSolicitud" class="form-select border-primary">
                        <option value="Pendiente">Pendiente</option>
                        <option value="En revisión">En revisión</option>
                        <option value="Aprobada">Aprobada</option>
                        <option value="Rechazada">Rechazada</option>
                    </select>
                    <span asp-validation-for="EstadoSolicitud" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Volver al Listado</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}